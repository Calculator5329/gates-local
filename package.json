{
  "name": "gates-local",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail typecheck",
    "lint": "oxlint --deny-warnings apps packages test",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "verify:runtime": "vitest run apps/server/src/settings apps/server/src/fit apps/server/src/runtime",
    "verify:image": "vitest run apps/server/src/image",
    "verify:gpu": "vitest run apps/server/src/gpu"
  },
  "devDependencies": {
    "@gates-local/contracts": "workspace:*",
    "@gates-local/harness": "workspace:*",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
