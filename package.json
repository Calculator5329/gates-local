{
  "name": "gates-local",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @gates-local/web build && node scripts/check-bundle.ts",
    "package:linux": "pnpm build && pnpm --filter @gates-local/desktop package:linux",
    "package:win": "pnpm build && pnpm --filter @gates-local/desktop package:win",
    "start": "pnpm --filter @gates-local/web build && pnpm --filter @gates-local/desktop start",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail typecheck",
    "lint": "oxlint --deny-warnings apps packages scripts test",
    "app-update": "node scripts/update.ts",
    "release:check": "node scripts/release-check.ts",
    "release:tag": "node scripts/release-tag.ts",
    "release:artifact": "node scripts/release-kit.ts artifact",
    "release:assemble": "node scripts/release-kit.ts assemble",
    "release:keygen": "node scripts/release-kit.ts keygen",
    "release:sign": "node scripts/release-kit.ts sign",
    "release:verify": "node scripts/release-kit.ts verify",
    "release:models": "node scripts/release-kit.ts models",
    "machine-check": "node scripts/machine-check.ts",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "verify:runtime": "vitest run apps/server/src/settings apps/server/src/fit apps/server/src/runtime",
    "verify:image": "vitest run apps/server/src/image",
    "verify:gpu": "vitest run apps/server/src/gpu",
    "e2e": "playwright test -c test/e2e/playwright.config.ts --project=e2e",
    "perf:compare": "node test/perf/compare.ts",
    "perf:next": "node test/perf/next-compare.ts",
    "e2e:timing": "playwright test -c test/e2e/playwright.config.ts --project=timing",
    "e2e:shots": "playwright test -c test/e2e/playwright.config.ts --project=shots",
    "shots:readme": "playwright test -c test/e2e/playwright.config.ts --project=readme",
    "verify:tools": "vitest run packages/harness apps/server/src/chat/tools.test.ts --reporter=verbose",
    "verify:sources": "vitest run apps/server/src/sources --reporter=verbose"
  },
  "devDependencies": {
    "@gates-local/contracts": "workspace:*",
    "@gates-local/harness": "workspace:*",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
