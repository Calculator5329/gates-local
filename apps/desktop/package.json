{
  "name": "@gates-local/desktop",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "desktopName": "gates-local.desktop",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.ts",
    "package:linux": "node scripts/package.ts",
    "package:win": "node scripts/package.ts --win",
    "start": "node scripts/build.ts && electron .",
    "smoke": "node scripts/build.ts && node scripts/smoke.ts"
  },
  "dependencies": {
    "@gates-local/contracts": "workspace:*"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "26.18.0"
  }
}
