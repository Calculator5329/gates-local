diff --git a/apps/web/src/image-picker.css b/apps/web/src/image-picker.css
index c4c8a9df..2b09c776 100644
--- a/apps/web/src/image-picker.css
+++ b/apps/web/src/image-picker.css
@@ -1,13 +1,11 @@
 /* ImagePicker-only rules over picker.css: a few presets, so the popover is as tall as its rows. */
 .image-picker{height:auto}
 .image-picker .pk-layout{grid-template-columns:44px 336px minmax(0,1fr)}
-.image-picker .pk-list-scroll{min-height:212px}
-/* both menus in one cell, the other hidden: the list is the taller one's height on either */
-.image-picker .pk-menus{display:grid}
-.image-picker .pk-menu{grid-area:1/1;min-width:0}
-.image-picker .pk-menu[inert]{visibility:hidden}
-/* the sizes never set the picker's height: they scroll inside the list's */
-.image-picker .pk-context{contain:size;overflow-y:auto}
+/* finder case: the image row 7 fix undone (the shown menu alone sets the list's height, the sizes set their own) */
+.image-picker .pk-list-scroll{min-height:136px}
+.image-picker .pk-menu{min-width:0}
+.image-picker .pk-menu[inert]{display:none}
+.image-picker .pk-context{overflow-y:auto}
 /* the button that opened the picker names it: no heading above the list, only a phone's Close */
 .image-picker .pk-search{display:none}
 .image-picker .pk-context-head>span{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:14px;color:var(--muted-foreground)}
