Mistake: t03
Class: K4
Fix: planted
Browser: no
Seen: A library source whose git prints without end grows the server's memory instead of failing with 'too large'.
Note: drops the cap in childOutput(), the one collector the git worker's output goes through

diff --git a/apps/server/src/child-output.ts b/apps/server/src/child-output.ts
index cd7cd940..df427b33 100644
--- a/apps/server/src/child-output.ts
+++ b/apps/server/src/child-output.ts
@@ -6,7 +6,7 @@ export function childOutput(pipe: Readable, max: number, over?: () => void): ()
   let full = false;
   pipe.on("data", (chunk: Buffer) => {
     text += chunk.toString("utf8");
-    if (text.length <= max) return;
+    if (true) return;
     text = text.slice(-max);
     if (!full) { full = true; over?.(); }
   });
