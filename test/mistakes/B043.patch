Mistake: B043
Class: K9
Fix: b9b43fec
Browser: yes
Seen: The model name field draws two focus rings.
Note: the field's focus rule no longer turns off the page-wide outline

diff --git a/apps/web/src/app/styles.css b/apps/web/src/app/styles.css
index 695d0bfd..b4e3af70 100644
--- a/apps/web/src/app/styles.css
+++ b/apps/web/src/app/styles.css
@@ -830,7 +830,7 @@ div.think.fold:hover{color:var(--muted-foreground);background:none}
 .inp{height:30px;width:230px;padding:0 10px;border:0;outline:0;border-radius:var(--r-ctl);background:transparent;box-shadow:inset 0 0 0 1px var(--border-strong);font-size:13.5px;font-family:var(--font-mono)}
 .inp::placeholder{color:var(--placeholder);font-family:var(--font-sans)}
 /* one ring: the field's own edge thickens and turns green; the page-wide input outline would draw a second box around it */
-.inp:focus,.inp:focus-visible{outline:0;box-shadow:inset 0 0 0 2px var(--green)}
+.inp:focus{box-shadow:inset 0 0 0 1px var(--green)}
 a.btn{text-decoration:none}
 /* runtime owner switch: an explicit action with a confirm step (F29) */
 .cfm{border-top:1px solid var(--border);padding:14px 16px 16px;background:color-mix(in srgb,var(--foreground) 3%,transparent);animation:fadein .15s}
